        <mxCell id="wc64tFirftS5UJ2tvuaX-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Logs/Traces/Metrics Streaming&lt;/h1&gt;&lt;p&gt;Represents internal integration for telemetry&lt;br&gt;1. Serilog -&amp;gt; &lt;font&gt;Sinks (&lt;/font&gt;&lt;a href=&quot;https://github.com/serilog/serilog/wiki/provided-sinks&quot;&gt;Provided Sinks · serilog/serilog Wiki&lt;/a&gt;)&lt;br&gt;2. nLog -&amp;gt; &lt;font&gt;Sinks (&lt;/font&gt;&lt;a style=&quot;background-color: transparent;&quot; href=&quot;https://nlog-project.org/config/&quot;&gt;Config | NLog&lt;/a&gt;)&lt;br&gt;3. Open Telemetry -&amp;gt; OTel (Traces, Logs, Metrics -&amp;nbsp;&lt;a style=&quot;background-color: transparent;&quot; href=&quot;https://opentelemetry.io/docs/languages/dotnet/&quot;&gt;.NET | OpenTelemetry&lt;/a&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;br&gt;4. New Relic Agent -&amp;gt; New Relic (Traces, Logs, Metrics)&lt;br&gt;...&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;perimeterSpacing=0;dashed=1;fillColor=none;fillStyle=auto;strokeColor=default;" parent="1" vertex="1">
