        <mxCell id="Y_guw_4IluHyYSohix8G-174" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Trigger and Trigger Message&lt;/h1&gt;&lt;p&gt;Trigger part of queue implies application event/execution triggering mechanism which is normally managed in cloud native integrations and enables push type of communication and also&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;may contain exact execution time for app to consider upon receival for accurate timing for job start time.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;perimeterSpacing=0;dashed=1;fillColor=none;fillStyle=auto;strokeColor=default;" parent="1" vertex="1">
          <mxGeometry x="1490" y="120" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="Y_guw_4IluHyYSohix8G-175" value="" style="endArrow=none;dashed=1;html=1;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#ABABAB;" parent="1" source="Y_guw_4IluHyYSohix8G-174" target="Y_guw_4IluHyYSohix8G-23" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1150" y="760" as="sourcePoint" />
            <mxPoint x="1200" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y_guw_4IluHyYSohix8G-176" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Message Decomposition&lt;/h1&gt;&lt;p&gt;It is recommended to decompose message from its data while transferring over queue in order to reduce changes of hitting queue scaling problems&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="1086.75" y="1000" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Y_guw_4IluHyYSohix8G-177" value="" style="endArrow=none;dashed=1;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;" parent="1" source="wc64tFirftS5UJ2tvuaX-7" target="Y_guw_4IluHyYSohix8G-176" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1241.75" y="1243.5" as="sourcePoint" />
            <mxPoint x="970" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y_guw_4IluHyYSohix8G-178" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Integrations&lt;/h1&gt;&lt;p&gt;Integrations may represent any kind of network interactivity with third party, external API calls or simply module that holds complex implementation but is not part of runner implementation and scales independently. Job runner supposed to start accurately and may or may not hold actual implementation due to implementation being a third party or if it must be independently scaled, queued, or otherwise&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;triggered by the Job runner.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="1390" y="790" width="640" height="130" as="geometry" />
